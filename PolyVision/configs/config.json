{
  "models": {
    "yolo": "models/detect/YOLOv8.1/best.pt",
    "yolo_weights": "models/detect/YOLOv8.1/best.pt",
    "local_classifier": "models/local/EfficientNetB0/best_model.keras",
    "global_classifier": "models/global/EfficientNetB0/best_model.keras",
    "enable_fusion": true
  },
  "classes": {
